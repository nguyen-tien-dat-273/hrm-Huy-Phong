# Sao thành deploy/vps/.env.vps (đã nằm trong .gitignore).
HRM_DOMAIN=hrm.example.com
API_DOMAIN=api.example.com
# Tên dịch vụ cổng API của Supabase trong mạng Docker + cổng nội bộ. KIỂM TRA bằng:
#   docker compose -f /opt/supabase-project/docker-compose.yml ps
# (thường là kong:8000; bản mới có thể đổi tên).
SUPABASE_GATEWAY=kong:8000
SUPABASE_DOCKER_NETWORK=supabase_default
