# ============================================================================
# Cấu hình HRM trên VPS — file thật là /opt/hrm/.env (chmod 600, KHÔNG đưa vào Git).
# install-supabase.sh tự tạo file này và tự điền các dòng đánh dấu (tự điền).
# ============================================================================

# Tên miền của HRM (bản ghi A trỏ về IP VPS). Giao diện và API Supabase dùng chung.  (tự điền)
DOMAIN=hrm.example.vn

# Lấy từ /opt/supabase/.env (ANON_KEY, SERVICE_ROLE_KEY, POSTGRES_PASSWORD).          (tự điền)
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
POSTGRES_PASSWORD=

# Nhắc nhở tự động (chấm công, KPI, hạn duyệt…): server tự chạy mỗi N phút.            (tự sinh)
CRON_SECRET=
REMINDER_INTERVAL_MINUTES=5

# Khoá ký bí danh cho trợ lý hỏi đáp.                                                 (tự sinh)

# ---- Phải tự điền (chép từ Vercel › Settings › Environment Variables) ----------------
# Thông báo đẩy: GIỮ NGUYÊN cặp khoá đang dùng, đổi khoá thì mọi máy đã đăng ký mất thông báo.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Trợ lý hỏi đáp (https://aistudio.google.com/apikey). Bỏ trống = tắt trợ lý.

# Máy chấm công: số sê-ri (HRM › Máy chấm công), nhiều máy ngăn bằng dấu phẩy. Rỗng = chặn mọi máy.
ATTENDANCE_DEVICE_SERIALS=
ATTENDANCE_UTC_OFFSET=+07:00
RJ_IN_STATUS_CODES=
RJ_OUT_STATUS_CODES=

REVERSE_GEOCODING_URL=https://nominatim.openstreetmap.org
APP_USER_AGENT=HuyPhongHRM/1.0

# ---- Sao lưu -------------------------------------------------------------------------
# Giờ chạy (giờ Việt Nam, 0–23) và số ngày giữ trên VPS (luôn giữ tối thiểu 3 bản).
BACKUP_HOUR=2
BACKUP_KEEP_DAYS=14
BACKUP_DIR=/opt/hrm-backups
BACKUP_UID=1000
BACKUP_GID=1000

# Chép ra NGOÀI VPS bằng rclone (rất nên có). Ví dụ remote mã hoá trên Google Drive:
#   RCLONE_REMOTE=hrm-mahoa:
# rclone.conf đặt ở /opt/hrm/secrets/rclone.conf (xem README.md, mục Sao lưu).
RCLONE_REMOTE=
BACKUP_REMOTE_KEEP_DAYS=60

# Báo khi sao lưu lỗi hoặc không chạy: tạo check miễn phí ở https://healthchecks.io
# (chu kỳ 1 ngày, ân hạn 2 giờ) rồi dán URL ping vào đây.
BACKUP_PING_URL=
