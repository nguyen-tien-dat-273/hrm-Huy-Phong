{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "allowImportingTsExtensions": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },
  // `api/` là Vercel Function chạy trên Node, cùng môi trường với vite.config.
  // Đưa vào đây để `npm run build` bắt lỗi kiểu ngay trên máy — trước đó thư
  // mục này không nằm trong tsconfig nào, nên lỗi chỉ lộ ra lúc Vercel build.
  "include": ["vite.config.ts", "api/**/*.ts"]
}
