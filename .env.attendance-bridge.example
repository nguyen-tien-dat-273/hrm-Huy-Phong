# URL và anon key của cùng dự án Supabase mà website đang dùng.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Token chỉ hiển thị một lần khi tạo trong HRM > Máy chấm công.
ATTENDANCE_BRIDGE_TOKEN=rj_replace_me

# Thông số mạng nội bộ trên máy Ronald Jack.
RJ_DEVICE_IP=192.168.1.201
RJ_DEVICE_PORT=4370
RJ_TRANSPORT=tcp
RJ_COMM_KEY=0
RJ_TIMEOUT_MS=10000

# Giờ trên máy là giờ Việt Nam; máy không gửi timezone trong bản ghi.
RJ_UTC_OFFSET=+07:00
RJ_POLL_MINUTES=5

# Tùy firmware. Nếu máy không phân biệt vào/ra, bridge vẫn lấy lần đầu/lần cuối.
RJ_IN_STATUS_CODES=0,2,4
RJ_OUT_STATUS_CODES=1,3,5

