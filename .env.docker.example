# Public URL used by browsers. Set to the HTTPS URL routed to Supabase Kong.
VITE_SUPABASE_URL=https://supabase.example.com

# Copy these values from the customer's self-hosted Supabase .env.
SUPABASE_ANON_KEY=replace-with-generated-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-generated-service-role-key
POSTGRES_PASSWORD=replace-with-generated-database-password

# The Supabase Docker project uses the "supabase" Compose project name by default.
SUPABASE_DOCKER_NETWORK=supabase_default
SUPABASE_INTERNAL_URL=http://api-gw:8000
SUPABASE_STORAGE_PATH=/opt/supabase-project/volumes/storage

# Set BACKUP_PATH to a mounted, access-restricted NAS directory.
BACKUP_PATH=/mnt/hrm-backups
BACKUP_UID=1000
BACKUP_GID=1000

# Bind HRM to localhost and terminate TLS at the customer's reverse proxy.
HRM_BIND_ADDRESS=127.0.0.1
HRM_PORT=8080

# Optional: leave empty to disable web push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Nhắc nhở tự động (chấm công, KPI, hạn duyệt...). Đặt một chuỗi ngẫu nhiên dài;
# để trống thì tắt nhắc nhở. Server tự chạy mỗi REMINDER_INTERVAL_MINUTES phút.
CRON_SECRET=
REMINDER_INTERVAL_MINUTES=5

# Trợ lý hỏi đáp: khoá lấy ở https://aistudio.google.com/apikey. Bỏ trống = tắt trợ lý.
GEMINI_API_KEY=
# Tuỳ chọn, mặc định gemini-2.5-flash.
GEMINI_MODEL=
REVERSE_GEOCODING_URL=https://nominatim.openstreetmap.org
APP_USER_AGENT=HuyPhongHRM/1.0 (mailto:admin@example.com)
