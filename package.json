{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "attendance:doctor": "node --env-file=.env.attendance-bridge tools/attendance-doctor.mjs",
    "attendance:sync": "node --env-file=.env.attendance-bridge tools/attendance-bridge.mjs --once",
    "attendance:bridge": "node --env-file=.env.attendance-bridge tools/attendance-bridge.mjs",
    "check:payroll": "esbuild client/src/lib/__tests__/payroll.check.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/payroll.check.cjs --log-level=error --define:import.meta.env={} && node node_modules/.cache/payroll.check.cjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.111.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "xlsx": "^0.18.5",
    "zkteco-protocol": "^0.6.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "bcryptjs": "^3.0.3",
    "esbuild": "^0.28.2",
    "pg": "^8.22.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
